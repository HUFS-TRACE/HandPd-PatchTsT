# .gitignore
data/
*.npz
__pycache__/
*.pyc

# 모델 체크포인트 (용량 큼) — results/*.csv, *.png 은 실험 결과라 커밋 대상
*.pt

# 실행 로그 (터미널 원문) — 수치는 results/*.csv 에 남으므로 커밋하지 않음
results/*_log.txt
# 원본 데이터 압축본 (용량 초과·데이터 비공개)
data.zip

# 백업·중간 산출물
*.bak
*.bak[0-9]
paper/*_backup_*
results/_*_b64.txt
results/_figkeys.txt
